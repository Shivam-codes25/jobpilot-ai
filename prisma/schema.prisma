generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Job {
  id                String   @id @default(uuid())
  title             String
  company           String
  location          String
  type              String
  url               String   @unique
  source            String
  matchScore        Int
  status            String   @default("Discovered")
  hrSearchQuery     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
